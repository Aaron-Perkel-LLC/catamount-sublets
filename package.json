{
  "name": "catamount-sublets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx src/db/seed.ts",
    "auth:generate": "npx @better-auth/cli@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts",
    "email:dev": "email dev --dir src/emails --port 3001",
    "migrate:legacy": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-legacy/index.ts",
    "delete-user": "node --env-file-if-exists=.env.local --import tsx scripts/admin/delete-user.ts",
    "check:brand": "bash scripts/check-brand.sh",
    "send-welcome": "node --env-file-if-exists=.env.local --import tsx scripts/admin/send-welcome.ts",
    "clear-rate-limits": "node --env-file-if-exists=.env.local --import tsx scripts/admin/clear-rate-limits.ts",
    "welcome-batches": "node --env-file-if-exists=.env.local --import tsx scripts/admin/welcome-batches.ts",
    "send-survey": "node --env-file-if-exists=.env.local --import tsx scripts/admin/send-survey.ts",
    "survey-export": "node --env-file-if-exists=.env.local --import tsx scripts/admin/survey-export.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-email/components": "^1.0.12",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.1",
    "@vercel/functions": "^3.9.11",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.1.1",
    "heic2any": "^0.0.4",
    "lucide-react": "^1.53.0",
    "maplibre-gl": "^6.13.0",
    "mysql2": "^3.24.5",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "react-email": "^6.11.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
