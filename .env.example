# Copy to .env.local. Never commit real values. Everything here is optional
# outside production: with no DATABASE_URL the app and tests use an in-process
# PGlite database, and with no RESEND_API_KEY mail is printed to the console.
# Delete any line you leave empty: src/env.ts rejects an empty value.

# Neon Postgres (Vercel integration). Development uses its own branch, never main.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# openssl rand -base64 32  (each)
APP_SECRET=
BETTER_AUTH_SECRET=

# Signs survey links (src/server/survey-token.ts): its own secret, never
# APP_SECRET, so the deployment's value can also live here and
# `npm run send-survey` signs links the site accepts.
SURVEY_SECRET=

# The canonical origin; on Vercel previews it falls back to VERCEL_URL.
APP_URL=http://localhost:3000

# Resend. The sending domain and addresses are in src/config/site.ts.
RESEND_API_KEY=

# The admin's own address(es), comma-separated: they may sign in without a school
# address, and the first gets admin notices and access requests. Inlined into the
# client bundle (the sign-in form checks it too), so set it before building.
NEXT_PUBLIC_ADMIN_EMAILS=

# Legacy migration only (scripts/migrate-legacy): the legacy admin's NetID, whose
# listings move to the first NEXT_PUBLIC_ADMIN_EMAILS address.
LEGACY_ADMIN_NETID=

# Vercel Blob: "uploads" is a private store (raw client uploads), "media" is
# public (processed images only).
BLOB_UPLOADS_READ_WRITE_TOKEN=
BLOB_MEDIA_READ_WRITE_TOKEN=

# Bearer token for /api/cron/* (set the same value in the Vercel project).
CRON_SECRET=
